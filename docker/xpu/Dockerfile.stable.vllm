# syntax=docker/dockerfile:1
# Intel GPU (XPU) image: vLLM rollout + FSDP/FSDP2 training.
# vllm: 0.29.0+xpu, torch: 2.13.0+xpu
#
# Build:
#   docker build -f docker/xpu/Dockerfile.stable.vllm -t verl:xpu-vllm029 .
# Build an unmerged branch (requirements-xpu.txt is read from the clone, so it must exist on that ref):
#   docker build -f docker/xpu/Dockerfile.stable.vllm \
#     --build-arg VERL_GIT_REPO=https://github.com/<user>/verl.git --build-arg VERL_REF=<branch> \
#     -t verl:xpu-vllm029-dev .
# See docker/xpu/README.md for run instructions.

# ubuntu24.04, not ubuntu26.04: the 2026.1 ubuntu26.04 variant segfaults on torch init.
# System oneAPI is not needed at runtime: torch/vllm bring their own SYCL runtime and oneCCL (pip oneccl 2022.0.0,
# which is the libccl the venv loads). The base is used for the toolchain, not as the runtime.
FROM intel/deep-learning-essentials:2026.1.0-devel-ubuntu24.04@sha256:6d0c782487d1f5d6e7d6772523cc2c3928d0aaa2213dbe88ad54733657c82332

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTHON_VERSION=3.12
ARG APT_MIRROR=""

ARG VLLM_VERSION=0.29.0
ARG PIP_INDEX_URL=https://download.pytorch.org/whl/xpu
ARG PIP_EXTRA_INDEX_URL=https://pypi.org/simple

ARG IGC_VERSION=2.34.4
ARG IGC_BUILD=21428
ARG COMPUTE_RUNTIME_VERSION=26.18.38308.1
ARG IGDGMM_VERSION=22.10.0
ARG LEVEL_ZERO_VERSION=1.28.2+u24.04

ARG VERL_GIT_REPO=https://github.com/verl-project/verl.git
ARG VERL_REF=main
# Intel XPU platform support lives in verl-hardware-plugin; pin a commit, its v0.1.0 tag predates XPU.
ARG PLUGIN_GIT_REPO=https://github.com/verl-project/verl-hardware-plugin.git
ARG PLUGIN_REF=e5ab532ae41a582bd2e9183c5deaf2bd8876045f

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN if [ -n "${APT_MIRROR}" ]; then \
    sed -i "s@http://.*archive.ubuntu.com@${APT_MIRROR}@g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi

RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libnuma-dev \
        numactl \
        python${PYTHON_VERSION} \
        python${PYTHON_VERSION}-dev \
        python3-pip \
        vim \
        wget && \
    rm -rf /var/lib/apt/lists/*

# compute-runtime >= 26.18: 26.09 reports free=0 from getMemoryInfo, which breaks vLLM's memory check.
RUN tmp_dir="$(mktemp -d)" && cd "${tmp_dir}" && \
    wget -q "https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC_VERSION}/intel-igc-core-2_${IGC_VERSION}+${IGC_BUILD}_amd64.deb" && \
    wget -q "https://github.com/intel/intel-graphics-compiler/releases/download/v${IGC_VERSION}/intel-igc-opencl-2_${IGC_VERSION}+${IGC_BUILD}_amd64.deb" && \
    wget -q "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_RUNTIME_VERSION}/intel-ocloc_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    wget -q "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_RUNTIME_VERSION}/intel-opencl-icd_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    wget -q "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_RUNTIME_VERSION}/libigdgmm12_${IGDGMM_VERSION}_amd64.deb" && \
    wget -q "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_RUNTIME_VERSION}/libze-intel-gpu1_${COMPUTE_RUNTIME_VERSION}-0_amd64.deb" && \
    wget -q "https://github.com/oneapi-src/level-zero/releases/download/v${LEVEL_ZERO_VERSION%%+*}/level-zero_${LEVEL_ZERO_VERSION}_amd64.deb" && \
    wget -q "https://github.com/oneapi-src/level-zero/releases/download/v${LEVEL_ZERO_VERSION%%+*}/level-zero-devel_${LEVEL_ZERO_VERSION}_amd64.deb" && \
    dpkg -i --force-overwrite ./*.deb && \
    cd / && rm -rf "${tmp_dir}"

ENV PATH="/root/.local/bin:/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_URL=${PIP_INDEX_URL} \
    UV_EXTRA_INDEX_URL=${PIP_EXTRA_INDEX_URL} \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    VLLM_TARGET_DEVICE=xpu

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    uv venv --python ${PYTHON_VERSION} --seed ${VIRTUAL_ENV}

# Prebuilt XPU wheel; the PyPI vllm wheel has no XPU kernels.
# --extra-index-url on the command line REPLACES UV_EXTRA_INDEX_URL, so PyPI is repeated here;
# without it vllm's plain-PyPI deps (e.g. lm-format-enforcer) are unresolvable.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "vllm==${VLLM_VERSION}+xpu" \
        --extra-index-url "https://wheels.vllm.ai/${VLLM_VERSION}/xpu" \
        --extra-index-url https://wheels.vllm.ai/xpu \
        --extra-index-url "${PIP_EXTRA_INDEX_URL}"

# Cloned to /opt, not /workspace, so a volume mounted at /workspace does not hide the editable installs.
RUN git clone "${VERL_GIT_REPO}" /opt/verl && \
    cd /opt/verl && git checkout "${VERL_REF}"

# requirements.txt is verl's own; requirements-xpu.txt is only the XPU overlay.
# - --no-config: run from /opt/verl, uv would read verl's pyproject [tool.uv].override-dependencies,
#   which pin transformers==5.12.1 and kernels<0.15 for the CUDA stack and silently beat the overlay.
# - grep -v transformers: a direct requirement cannot be overridden, so verl's transformers<5.13 is dropped.
# - --override pyzes: torch 2.13.0+xpu pins pyzes==0.1.1. Keep the override to pyzes alone; an unpinned
#   entry there would also erase torch's own triton-xpu pin.
# - liger-kernel pulls the CUDA triton, which shares triton/ with triton-xpu: remove it, then reinstall
#   triton-xpu at the version the resolver chose.
RUN --mount=type=cache,target=/root/.cache/uv \
    grep -v '^transformers' /opt/verl/requirements.txt > /tmp/requirements-core.txt && \
    echo 'pyzes>=0.1.2' > /tmp/override-pyzes.txt && \
    uv --no-config pip install -r /tmp/requirements-core.txt -r /opt/verl/requirements-xpu.txt \
        --override /tmp/override-pyzes.txt && \
    uv --no-config pip install --no-deps -e /opt/verl && \
    TRITON_XPU="$(uv pip freeze | grep -i '^triton-xpu==')" && \
    (uv pip uninstall triton || true) && \
    uv pip install --reinstall --no-deps "${TRITON_XPU}" --extra-index-url https://download.pytorch.org/whl/xpu

# --no-deps: the plugin declares verl>=0.7.0, which would replace /opt/verl with a PyPI release.
RUN --mount=type=cache,target=/root/.cache/uv \
    git clone "${PLUGIN_GIT_REPO}" /opt/verl-hardware-plugin && \
    cd /opt/verl-hardware-plugin && git checkout "${PLUGIN_REF}" && \
    uv pip install --no-deps -e .

WORKDIR /opt/verl

CMD ["/bin/bash"]
